{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Preflight decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["opportunity_id", "decision", "required_fields", "blockers", "verified_at"],
  "properties": {
    "opportunity_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["READY", "DEAD", "DUPLICATE", "LOCATION", "WORK_AUTH", "LANGUAGE", "DEGREE", "EXPERIENCE", "COMPENSATION", "ESSAY", "PORTFOLIO", "ASSESSMENT", "CAPTCHA", "STAFFING", "NEEDS_REVIEW"]},
    "required_fields": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "verified_at": {"type": "string", "minLength": 1},
    "reason": {"type": "string"}
  }
}
