[Unit]
Description=Job runner low-priority Denmark sweep
After=network-online.target

[Service]
Type=oneshot
User=jobrunner
Group=jobrunner
ExecStart=/usr/local/bin/jobctl sweep --lane denmark
ExecStartPre=/usr/local/bin/jobctl plugin-health jobnet jobindex jobdanmark jobbank
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/job-runner/data
