{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded sweep output",
  "type": "object",
  "additionalProperties": false,
  "required": ["survivors"],
  "properties": {
    "survivors": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["opportunity_id", "company", "role", "direct_url", "location", "source_plugin", "fit", "possible_blockers", "verified_at"],
        "properties": {
          "opportunity_id": {"type": "string", "minLength": 1},
          "company": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "direct_url": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1},
          "source_plugin": {"type": "string", "minLength": 1},
          "fit": {"enum": ["high", "medium", "low"]},
          "possible_blockers": {"type": "array", "items": {"type": "string"}},
          "verified_at": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
